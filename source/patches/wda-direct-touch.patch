+#if !TARGET_OS_TV && !TARGET_OS_WATCH
++ (id<FBResponsePayload>)handleTapScreenInfo:(FBRouteRequest *)request
+{
+  return FBResponseWithObject(@{@"version": @1, @"coordinateSpace": @"screen-points",
+                                @"touchDuration": @0.125});
+}
+
++ (id<FBResponsePayload>)handleTapScreen:(FBRouteRequest *)request
+{
+  NSNumber *x = request.arguments[@"x"];
+  NSNumber *y = request.arguments[@"y"];
+  if (![x isKindOfClass:NSNumber.class] || ![y isKindOfClass:NSNumber.class]
+      || !isfinite(x.doubleValue) || !isfinite(y.doubleValue)) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Finite screen x/y are required" traceback:nil]);
+  }
+  // Coordinates and orientation come from the caller's screen observation.
+  // Do not resolve XCUIApplication, element.frame, or XCUICoordinate.screenPoint.
+  UIInterfaceOrientation orientation = request.arguments[@"orientation"]
+    ? [request.arguments[@"orientation"] integerValue] : UIInterfaceOrientationPortrait;
+  XCPointerEventPath *path = [[XCPointerEventPath alloc]
+                            initForTouchAtPoint:CGPointMake(x.doubleValue, y.doubleValue) offset:0];
+  [path liftUpAtOffset:0.125];
+  XCSynthesizedEventRecord *event = [XCSynthesizedEventRecord instancesRespondToSelector:@selector(initWithName:displayID:interfaceOrientation:)]
+    ? [[XCSynthesizedEventRecord alloc] initWithName:@"Direct screen tap"
+                                         displayID:(unsigned long long)[FBScreen displayID]
+                              interfaceOrientation:orientation]
+    : [[XCSynthesizedEventRecord alloc] initWithName:@"Direct screen tap" interfaceOrientation:orientation];
+  [event addPointerEventPath:path];
+  NSError *error = nil;
+  if (![FBXCTestDaemonsProxy synthesizeEventWithRecord:event error:&error]) {
+    return FBResponseWithUnknownError(error);
+  }
+  return FBResponseWithObject(@{@"actionExecuted": @YES, @"method": @"direct-screen-event"});
+}
+#endif
